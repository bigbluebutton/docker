#!/bin/bash

set -e
cd "$(dirname "$0")/.."

# load .env
. scripts/functions.sh
load_env

if [ -z "$ENABLE_WEBHOOKS" ]; then
    echo "ERROR: ENABLE_WEBHOOKS must be set to true, otherwise the image would not be built"
    exit 1
fi

if [ -z "$ENABLE_RECORDING" ]; then
    echo "ERROR: ENABLE_RECORDING must be set to true, otherwise the image would not be built"
    exit 1
fi

if [ -z "$ENABLE_SIP_DIALIN" ]; then
    echo "ERROR: ENABLE_SIP_DIALIN must be set to true, otherwise the image would not be built"
    exit 1
fi


# generate compose file
./scripts/generate-compose

# ensure submodules are correctly checked out
git submodule update  

# build and push java base image
docker build --pull -t alangecker/bbb-docker-base-java:21 mod/base-java

# buld and push other images
docker compose build --pull

# push images
docker push alangecker/bbb-docker-base-java:21
docker compose push \
    apps-akka \
    bbb-export-annotations \
    livekit-sip \
    bbb-graphql-actions \
    bbb-graphql-middleware \
    bbb-graphql-server \
    bbb-shared-notes-server \
    bbb-web \
    bbb-webrtc-recorder \
    https-proxy \
    livekit \
    nginx \
    recordings \
    webhooks \
    webrtc-sfu \
    freeswitch
